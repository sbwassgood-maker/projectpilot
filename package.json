{
  "name": "projectpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "bash scripts/with-db.sh",
    "db:migrate": "bash scripts/with-db.sh npx prisma migrate deploy",
    "db:seed": "bash scripts/with-db.sh node scripts/run-node-script.js scripts/seed.ts",
    "e2e": "bash scripts/with-db.sh node scripts/run-node-script.js scripts/e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "openai": "^7.16.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "prisma": "^6.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
