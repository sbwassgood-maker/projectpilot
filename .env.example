# ---------------------------------------------------------------------------
# ProjectPilot environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All secrets are read server-side only and are never exposed to the browser.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma at runtime.
# On Vercel + Neon, use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://projectpilot:projectpilot@localhost:5432/projectpilot?schema=public"

# Direct (non-pooled) connection used ONLY for migrations (prisma migrate deploy).
# On Vercel + Neon set this to the value Neon labels DATABASE_URL_UNPOOLED.
# Locally, set it to the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://projectpilot:projectpilot@localhost:5432/projectpilot?schema=public"

# Secret used to sign session/auth tokens. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# AI layer
# ---------------------------------------------------------------------------
# Which AI provider to use for document intelligence.
#   openai -> real OpenAI API (requires OPENAI_API_KEY below)
#   mock   -> deterministic local extractor (no key required; for local/offline dev)
AI_PROVIDER="openai"

# OpenAI API key. Read ONLY on the server. Never hard-code, never send to client.
OPENAI_API_KEY=

# Model used for extraction + report generation.
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Local filesystem directory where uploaded documents are stored in DEV.
# Ignored when BLOB_READ_WRITE_TOKEN is set (production uses Vercel Blob).
FILE_STORAGE_DIR="./storage/uploads"

# Vercel Blob token. REQUIRED in production (Vercel) because the serverless
# filesystem is ephemeral. Create a Blob store in the Vercel dashboard and this
# variable is added automatically. Leave empty for local filesystem dev.
BLOB_READ_WRITE_TOKEN=
